{
  "id": "reserve",
  "name": "Réserve",
  "description": "Le référentiel des produits et des fournisseurs.",
  "modules": [
    {
      "id": "produits",
      "name": "Produits",
      "singular": "Produit",
      "description": "Références et caractéristiques du catalogue.",
