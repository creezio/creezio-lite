{
  "name": "@creezio/fleet",
  "version": "0.26.0",
  "description": "Backend flotte typé — gestes Docker (Engine API), registre serveurs, updates pull/rollback, agent hôte, proxy registre pull-only, protocole agent↔backend versionné (ex fleet-collector .mjs)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./docker": {
      "types": "./dist/docker.d.ts",
      "import": "./dist/docker.js",
      "default": "./dist/docker.js"
    },
    "./server-lib": {
      "types": "./dist/server-lib.d.ts",
      "import": "./dist/server-lib.js",
      "default": "./dist/server-lib.js"
    },
    "./instance-stack": {
      "types": "./dist/instance-stack.d.ts",
      "import": "./dist/instance-stack.js",
      "default": "./dist/instance-stack.js"
    },
    "./agent-updates": {
      "types": "./dist/agent-updates.d.ts",
      "import": "./dist/agent-updates.js",
      "default": "./dist/agent-updates.js"
    },
    "./update-status-store": {
      "types": "./dist/update-status-store.d.ts",
      "import": "./dist/update-status-store.js",
      "default": "./dist/update-status-store.js"
    },
    "./registry-pull-proxy": {
      "types": "./dist/registry-pull-proxy.d.ts",
      "import": "./dist/registry-pull-proxy.js",
      "default": "./dist/registry-pull-proxy.js"
    },
    "./server-admin": {
      "types": "./dist/server-admin.d.ts",
      "import": "./dist/server-admin.js",
      "default": "./dist/server-admin.js"
    },
    "./host-agent": {
      "types": "./dist/host-agent.d.ts",
      "import": "./dist/host-agent.js",
      "default": "./dist/host-agent.js"
    },
    "./server-admin-main": {
      "types": "./dist/bin/server-admin-main.d.ts",
      "import": "./dist/bin/server-admin-main.js",
      "default": "./dist/bin/server-admin-main.js"
    },
    "./host-agent-main": {
      "types": "./dist/bin/host-agent-main.d.ts",
      "import": "./dist/bin/host-agent-main.js",
      "default": "./dist/bin/host-agent-main.js"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "license": "UNLICENSED",
  "module": "./dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/creezio/creezio.git",
    "directory": "packages/fleet"
  },
  "engines": {
    "node": ">=22.5"
  }
}
