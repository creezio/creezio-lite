{
  "name": "@creezio/assistant",
  "version": "0.26.0",
  "description": "Chat / assistant plateforme Creezio (store + runtime + UI + chat SSE O4)",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./ui/index.ts",
      "import": "./ui/index.ts",
      "default": "./ui/index.ts"
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "ui"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@creezio/platform-core": "^0.26.0",
    "@creezio/shell": "^0.26.0",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.12.30"
  },
  "peerDependencies": {
    "@creezio/shell-ui": ">=0.4.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": ">=0.400.0",
    "react": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "@creezio/shell-ui": {
      "optional": true
    },
    "@radix-ui/react-dropdown-menu": {
      "optional": true
    },
    "@radix-ui/react-scroll-area": {
      "optional": true
    },
    "@radix-ui/react-select": {
      "optional": true
    },
    "@radix-ui/react-slot": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "clsx": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "typescript": "^5.8.3"
  },
  "license": "UNLICENSED",
  "module": "./dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/creezio/creezio.git",
    "directory": "packages/assistant"
  },
  "engines": {
    "node": ">=22.5"
  }
}
