{
  "name": "@creezio/electron-shell",
  "version": "0.26.0",
  "description": "Runtime Electron plateforme Creezio (updater, tray, splash, boot, launchers génériques)",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./browser-tabs": {
      "types": "./dist/host/browser-tabs/index.d.ts",
      "import": "./dist/host/browser-tabs/index.js",
      "require": "./dist-cjs/host/browser-tabs/index.js",
      "default": "./dist/host/browser-tabs/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "browser-tabs": [
        "./dist/host/browser-tabs/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@creezio/brand-config": "^0.26.0",
    "@creezio/browser-host": "^0.26.0",
    "@creezio/host-runtime": "^0.26.0",
    "@creezio/observability": "^0.26.0",
    "@creezio/platform-core": "^0.26.0",
    "@creezio/product-hub": "^0.26.0",
    "@creezio/search": "^0.26.0",
    "@creezio/shell": "^0.26.0"
  },
  "peerDependencies": {
    "electron": ">=28",
    "electron-updater": ">=6"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "electron-updater": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "license": "UNLICENSED",
  "module": "./dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/creezio/creezio.git",
    "directory": "packages/electron-shell"
  },
  "engines": {
    "node": ">=22.5"
  }
}
