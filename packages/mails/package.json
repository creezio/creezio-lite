{
  "name": "@creezio/mails",
  "version": "0.26.0",
  "description": "Mails natifs plateforme Creezio (boîte générique + PJ + UI + slot providers marque)",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./ui/index.ts",
      "import": "./ui/index.ts",
      "default": "./ui/index.ts"
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "ui",
    "email-worker"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:inbox": "node ../../scripts/test-mails-inbox.mjs"
  },
  "dependencies": {
    "@creezio/api-kernel": "^0.26.0",
    "@creezio/auth": "^0.26.0",
    "@creezio/platform-core": "^0.26.0",
    "@creezio/shell-ui": "^0.26.0",
    "hono": "^4.12.30"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.5",
    "nodemailer": "^7.0.9",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@tiptap/extension-link": ">=2.0.0",
    "@tiptap/react": ">=2.0.0",
    "@tiptap/starter-kit": ">=2.0.0",
    "imapflow": ">=1.0.0",
    "lucide-react": ">=0.400.0",
    "mailparser": ">=3.0.0",
    "nodemailer": ">=6.9.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/extension-link": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "imapflow": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "mailparser": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "license": "UNLICENSED",
  "module": "./dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/creezio/creezio.git",
    "directory": "packages/mails"
  },
  "engines": {
    "node": ">=22.5"
  }
}
