{
  "name": "@creezio/observability",
  "version": "0.26.0",
  "description": "Observabilité — activité/CP + ops/fleet + fleet-collector (P25) + usage analytics (N6) + request-logs admin (O5)",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "creezio-fleet-collector": "./fleet-collector/server.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./ui/index.ts",
      "import": "./ui/index.ts",
      "default": "./ui/index.ts"
    },
    "./fleet-collector/*": "./fleet-collector/*"
  },
  "files": [
    "dist",
    "dist-cjs",
    "ui",
    "fleet-collector",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fleet-collector": "node fleet-collector/server.mjs",
    "test:fleet-collector": "node fleet-collector/test-fleet-collector.mjs",
    "test:server-admin": "node fleet-collector/test-server-admin.mjs",
    "test:api-endpoints": "node scripts/test-api-endpoints-registry.mjs"
  },
  "dependencies": {
    "@creezio/api-kernel": "^0.26.0",
    "@creezio/fleet": "^0.26.0",
    "@creezio/platform-core": "^0.26.0",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "typescript": "^5.8.3"
  },
  "license": "UNLICENSED",
  "module": "./dist/index.js",
  "peerDependencies": {
    "@creezio/auth": ">=0.4.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": ">=0.400.0",
    "next": ">=14.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "recharts": ">=2.0.0",
    "tailwind-merge": "^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "@creezio/auth": {
      "optional": true
    },
    "@radix-ui/react-slot": {
      "optional": true
    },
    "@radix-ui/react-tabs": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "clsx": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/creezio/creezio.git",
    "directory": "packages/observability"
  },
  "engines": {
    "node": ">=22.5"
  }
}
