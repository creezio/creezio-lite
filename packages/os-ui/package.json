{
  "name": "@creezio/os-ui",
  "version": "0.26.0",
  "description": "Surfaces Next OS natives (mails, tasks, setup, admin…) — matérialisées hors git dans les marques",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./boot": {
      "types": "./src/boot.tsx",
      "import": "./src/boot.tsx",
      "default": "./src/boot.tsx"
    },
    "./materialize": {
      "import": "./scripts/materialize.mjs",
      "default": "./scripts/materialize.mjs"
    }
  },
  "files": [
    "dist",
    "routes",
    "src",
    "scripts"
  ],
  "bin": {
    "creezio-materialize-os-ui": "./scripts/materialize.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "materialize": "node ./scripts/materialize.mjs"
  },
  "dependencies": {
    "@creezio/interactive-demo": "^0.26.0",
    "@creezio/mails": "^0.26.0",
    "@creezio/nav": "^0.26.0",
    "@creezio/shell-ui": "^0.26.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.8.3"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/creezio/creezio.git",
    "directory": "packages/os-ui"
  },
  "engines": {
    "node": ">=22.5"
  }
}
