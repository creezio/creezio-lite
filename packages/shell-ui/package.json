{
  "name": "@creezio/shell-ui",
  "version": "0.26.0",
  "description": "Nav + slots + shell CRM UI / libs plateforme (O9)",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./ui/index.ts",
      "import": "./ui/index.ts",
      "default": "./ui/index.ts"
    },
    "./ui/kit": {
      "types": "./ui/kit.ts",
      "import": "./ui/kit.ts",
      "default": "./ui/kit.ts"
    },
    "./ui/os-pages": {
      "types": "./ui/os-pages/index.ts",
      "import": "./ui/os-pages/index.ts",
      "default": "./ui/os-pages/index.ts"
    },
    "./ui/settings/*": {
      "types": "./ui/settings/*.tsx",
      "import": "./ui/settings/*.tsx",
      "default": "./ui/settings/*.tsx"
    },
    "./ui/primitives/*": {
      "types": "./ui/primitives/*.tsx",
      "import": "./ui/primitives/*.tsx",
      "default": "./ui/primitives/*.tsx"
    },
    "./theme.css": "./ui/theme/theme.css",
    "./tailwind-preset": "./ui/theme/tailwind-preset.cjs"
  },
  "files": [
    "dist",
    "dist-cjs",
    "ui"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@creezio/brand-config": "^0.26.0",
    "@creezio/shell": "^0.26.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@creezio/assistant": ">=0.4.0",
    "@creezio/auth": ">=0.4.0",
    "@radix-ui/react-avatar": "^1.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "@radix-ui/react-label": "^2.0.0",
    "@radix-ui/react-scroll-area": "^1.0.0",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "react-resizable-panels": "^2.1.0 || ^3.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": ">=1.0.0",
    "lucide-react": ">=0.400.0",
    "next": ">=14.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "recharts": ">=2.0.0",
    "sonner": ">=1.0.0",
    "tailwind-merge": "^3.6.0"
  },
