    "@creezio/product-hub": "^0.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "license": "UNLICENSED",
  "module": "./dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/creezio/creezio.git",
    "directory": "packages/automations"
  },
